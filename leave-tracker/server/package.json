{
  "name": "leave-tracker-server",
  "version": "1.0.0",
  "private": true,
  "description": "Leave Tracker REST API",
  "engines": {
    "node": ">=16.20"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "node -r ts-node/register src/index.ts",
    "db:setup": "node -r ts-node/register scripts/db.ts setup",
    "db:reset": "node -r ts-node/register scripts/db.ts reset",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "16.18.126",
    "@types/sql.js": "1.4.11",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "nodemon": "3.1.14",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
